# FastAPI Settings
ENVIRONMENT=development
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection
# SQLite fallback (default for local development and testing):
DATABASE_URL=sqlite:///./readmissions.db
# PostgreSQL (production/docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_readmissions
